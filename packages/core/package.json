{
  "name": "@clubscope/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Framework-free domain, analysis tools, grounding verifier, scoring and evals. No web framework, no model SDK — so every guarantee here is unit-testable on its own.",
  "exports": {
    ".": "./src/index.ts",
    "./domain": "./src/domain/types.ts",
    "./tools": "./src/tools/index.ts",
    "./verify": "./src/verify/verifier.ts",
    "./scoring": "./src/scoring/churn.ts",
    "./data": "./src/data/index.ts",
    "./insights": "./src/insights/index.ts",
    "./assistant": "./src/assistant/index.ts",
    "./evals": "./src/evals/index.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "evals": "tsx src/evals/cli.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
